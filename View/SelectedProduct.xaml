<Window x:Class="NewAPP.View.SelectedProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewAPP.View"
        mc:Ignorable="d"
        Title="Выбор товаров" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Стиль для кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#F0F0F0" Offset="0"/>
                        <GradientStop Color="#E0E0E0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                                <GradientStop Color="#E0E8FF" Offset="0"/>
                                <GradientStop Color="#D0D8F0" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Доступные товары -->
        <Border Grid.Column="0" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                CornerRadius="5"
                Padding="5"
                Background="#F9F9F9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📦 Доступные товары" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- Поиск -->
                <TextBox x:Name="SearchTextBox"
                         Grid.Row="1"
                         TextChanged="SearchTextBox_TextChanged"
                         Margin="0,0,0,10"
                         Tag="Поиск..."/>

                <!-- Список товаров -->
                <ListBox x:Name="AvailableProductsListBox"
                         Grid.Row="2"
                         SelectionMode="Extended"
                         SelectionChanged="AvailableProductsListBox_SelectionChanged"
                         Margin="0,0,0,10"/>

                <!-- Статус -->
                <TextBlock x:Name="AvailableCountText"
                           Grid.Row="3" 
                           Foreground="Gray"
                           FontSize="11"/>
            </Grid>
        </Border>

        <!-- ЦЕНТРАЛЬНЫЕ КНОПКИ -->
        <StackPanel Grid.Column="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
            <Button x:Name="AddSelectedButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="▶" 
                    Click="AddSelectedButton_Click"
                    ToolTip="Добавить выбранные"/>

            <Button x:Name="AddAllButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="▶▶" 
                    Click="AddAllButton_Click"
                    ToolTip="Добавить все"/>

            <Button x:Name="RemoveSelectedButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="◀" 
                    Click="RemoveSelectedButton_Click"
                    ToolTip="Удалить выбранные"/>

            <Button x:Name="RemoveAllButton"
                    Style="{StaticResource ActionButtonStyle}"
                    Content="◀◀" 
                    Click="RemoveAllButton_Click"
                    ToolTip="Удалить все"/>
        </StackPanel>

        <!-- ПРАВАЯ ПАНЕЛЬ: Выбранные товары -->
        <Border Grid.Column="2" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                CornerRadius="5"
                Padding="5"
                Background="#F9F9F9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="✅ Выбранные товары" 
                               FontSize="14" 
                               FontWeight="Bold"/>
                    <TextBlock x:Name="SelectedCountText" 
                               Foreground="Blue"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>

                <ListBox x:Name="SelectedProductsListBox"
                         Grid.Row="1"
                         SelectionMode="Extended"
                         SelectionChanged="SelectedProductsListBox_SelectionChanged"
                         Margin="0,0,0,10"/>

                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="OkButton" 
                            Content="✅ OK" 
                            Click="OkButton_Click"
                            Width="80" Height="35"
                            Margin="5"
                            Background="#4CAF50"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                    <Button x:Name="CancelButton" 
                            Content="❌ Отмена" 
                            Click="CancelButton_Click"
                            Width="80" Height="35"
                            Margin="5"
                            Background="#F44336"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
